# LANscape local dev configuration.
# Copy this file to `.env` (same directory) to enable
# `python -m lanscape --debug` as a hot-reloading dev environment.

# Path to the lanscape-ui repo (Vite/React frontend).
# Relative paths resolve from the py-net-scan repo root.
LANSCAPE_UI_PATH=../lanscape-ui

# Command to start the UI dev server, run inside LANSCAPE_UI_PATH.
# Placeholders: {ui_port}, {ws_port}
LANSCAPE_UI_DEV_CMD=npm run dev -- --port {ui_port} --strictPort

# Open a PWA window pointed at the dev server when it's ready.
LANSCAPE_OPEN_BROWSER=true

# Restart the Python backend on .py changes (uses watchdog from dev extras).
LANSCAPE_AUTO_RELOAD=true
